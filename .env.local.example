# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase: Project Settings > API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same project, public values — used by the browser for sign-in.
# Safe to expose: middleware is what actually gates access, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The exact email of the one Supabase Auth user allowed in — middleware
# rejects any other signed-in session, even if someone else self-registers.
OWNER_EMAIL=

# Adzuna: sign up free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Any random string you make up — secures the daily cron endpoint.
# Only needed once deployed to Vercel; not used when running locally.
CRON_SECRET=

# Anthropic API key from console.anthropic.com — starts with sk-ant-
ANTHROPIC_API_KEY=

# Jooble: request a free key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase: Project Settings > API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any password you choose — this gates the whole app via Basic Auth
APP_PASSWORD=

# Adzuna: sign up free at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Any random string you make up — secures the daily cron endpoint.
# Only needed once deployed to Vercel; not used when running locally.
CRON_SECRET=
